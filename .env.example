# Public origin used for auth redirects and same-origin protection.
SIGNALOPS_PUBLIC_URL=http://127.0.0.1:3020

# Local-only bootstrap tenant. Hosted tenants and memberships live in Supabase.
SIGNALOPS_WORKSPACE_SLUG=demo
SIGNALOPS_WORKSPACE_NAME=Demo Workspace
SIGNALOPS_DEFAULT_TENANT_SLUG=demo

# Operator authentication. Production uses Supabase email OTP and/or an allowlisted OAuth provider.
SIGNALOPS_AUTH_EMAIL_OTP=true
# Comma-separated Supabase providers, for example: google,github
SIGNALOPS_AUTH_PROVIDERS=
SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= may be used instead, but the browser never needs it today.
SIGNALOPS_SESSION_SECRET=
# Optional zero-downtime rotation window for sessions signed by the previous key.
SIGNALOPS_SESSION_SECRET_PREVIOUS=
SIGNALOPS_SESSION_TTL_SECONDS=28800

# Password auth is a local fallback and fails closed in production unless explicitly enabled.
SIGNALOPS_ALLOW_PASSWORD_AUTH=false
SIGNALOPS_COCKPIT_PASSWORD=

# Local bootstrap ingest credential. Hosted production uses hashed, revocable database credentials.
SIGNALOPS_INGEST_TOKEN=
# Prefer a SHA-256 hash in hosted environments; the raw token remains client-side.
# SIGNALOPS_INGEST_TOKEN_HASH=
SIGNALOPS_ALLOW_BOOTSTRAP_CREDENTIAL=false
SIGNALOPS_INGEST_RATE_LIMIT_MAX=600
SIGNALOPS_INGEST_RATE_LIMIT_WINDOW_SECONDS=60
SIGNALOPS_RATE_LIMIT_SECRET=

# Local storage is intentionally opt-in and must stay disabled on ephemeral production runtimes.
SIGNALOPS_LOCAL_STORE_PATH=.data/signalops-v1-events.jsonl
SIGNALOPS_ALLOW_LOCAL_STORE=false
SIGNALOPS_EVENT_PRIVACY_MODE=redact
SIGNALOPS_ALLOW_EPHEMERAL_INGEST=false

# Internal evaluator/retention job. Vercel sends CRON_SECRET automatically.
CRON_SECRET=
# SIGNALOPS_CRON_SECRET= is supported as a non-Vercel alternative.
SIGNALOPS_RETENTION_ENABLED=false
SIGNALOPS_RAW_RETENTION_DAYS=100
SIGNALOPS_CONFLICT_RETENTION_DAYS=400
SIGNALOPS_AUDIT_RETENTION_DAYS=400
SIGNALOPS_RATE_LIMIT_RETENTION_DAYS=2

# Signed incident delivery. A destination is required for production readiness.
SIGNALOPS_ALERT_WEBHOOK_URL=
SIGNALOPS_ALERT_WEBHOOK_SECRET=
SIGNALOPS_ALERT_COST_THRESHOLD_USD=1

# Pilot-request delivery is separate from operational incident delivery.
SIGNALOPS_PILOT_REQUEST_WEBHOOK_URL=
SIGNALOPS_PILOT_REQUEST_WEBHOOK_SECRET=
# Optional fallback delivery for pilot requests when no dedicated pilot webhook exists.
SIGNALOPS_PILOT_REQUEST_EMAIL_TO=
SIGNALOPS_PILOT_REQUEST_EMAIL_FROM=
SIGNALOPS_RESEND_API_KEY=
NEXT_PUBLIC_SIGNALOPS_PILOT_FALLBACK_EMAIL=

# PostHog product analytics (US Cloud project 572150 in production).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Required durable storage and auth target for hosted production.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# New Supabase projects can use the server-only secret key instead.
# SUPABASE_SECRET_KEY=
