{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalops.cc/schemas/ai-telemetry/v1",
  "title": "SignalOps Canonical AI Telemetry Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data"
  ],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/eventIdentifier" },
    "source": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 240
    },
    "type": {
      "enum": [
        "com.signalops.ai.operation.accepted.v1",
        "com.signalops.ai.operation.terminal.v1",
        "com.signalops.ai.attempt.started.v1",
        "com.signalops.ai.attempt.terminal.v1",
        "com.signalops.ai.provider.probe.v1"
      ]
    },
    "subject": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^(operation|provider)/[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "time": { "$ref": "#/$defs/timestamp" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "const": "https://signalops.cc/schemas/ai-telemetry/v1" },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}(?:-[\u0021-\u007e]+)?$",
      "maxLength": 512
    },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "com.signalops.ai.operation.accepted.v1" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "subject": { "type": "string", "pattern": "^operation/" },
          "data": { "$ref": "#/$defs/operationAcceptedData" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "com.signalops.ai.operation.terminal.v1" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "subject": { "type": "string", "pattern": "^operation/" },
          "data": { "$ref": "#/$defs/operationTerminalData" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "com.signalops.ai.attempt.started.v1" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "subject": { "type": "string", "pattern": "^operation/" },
          "data": { "$ref": "#/$defs/attemptStartedData" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "com.signalops.ai.attempt.terminal.v1" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "subject": { "type": "string", "pattern": "^operation/" },
          "data": { "$ref": "#/$defs/attemptTerminalData" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "com.signalops.ai.provider.probe.v1" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "subject": { "type": "string", "pattern": "^provider/" },
          "data": { "$ref": "#/$defs/providerProbeData" }
        }
      }
    }
  ],
  "$defs": {
    "eventIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "operationKind": {
      "enum": [
        "image_generation",
        "video_generation",
        "text_generation",
        "embedding",
        "transcription",
        "training",
        "other"
      ]
    },
    "terminalStatus": {
      "enum": ["succeeded", "failed", "cancelled", "expired", "abandoned"]
    },
    "failureCategory": {
      "enum": [
        "provider_capacity",
        "provider_rate_limit",
        "provider_auth",
        "provider_rejected",
        "provider_timeout",
        "provider_error",
        "content_policy",
        "invalid_input",
        "customer_cancelled",
        "client_configuration",
        "application_error",
        "postprocessing_error",
        "storage_error",
        "unknown"
      ]
    },
    "failureResponsibility": {
      "enum": ["provider", "customer", "client", "platform", "unknown"]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/operationKind" },
        "logicalModelKey": { "$ref": "#/$defs/identifier" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "number": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerKey", "modelKey"],
      "properties": {
        "providerKey": { "$ref": "#/$defs/identifier" },
        "providerVendor": { "$ref": "#/$defs/identifier" },
        "modelKey": { "$ref": "#/$defs/identifier" },
        "providerModelKey": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "probeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerKey"],
      "properties": {
        "providerKey": { "$ref": "#/$defs/identifier" },
        "providerVendor": { "$ref": "#/$defs/identifier" },
        "modelKey": { "$ref": "#/$defs/identifier" },
        "providerModelKey": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "responsibility"],
      "properties": {
        "category": { "$ref": "#/$defs/failureCategory" },
        "responsibility": { "$ref": "#/$defs/failureResponsibility" },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "retryable": { "type": "boolean" }
      }
    },
    "terminalOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "succeeded" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "cancelled" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "failure"],
          "properties": {
            "status": { "enum": ["failed", "expired", "abandoned"] },
            "failure": { "$ref": "#/$defs/failure" }
          }
        }
      ]
    },
    "probeOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "succeeded" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "failure"],
          "properties": {
            "status": { "const": "failed" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        }
      ]
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "source"],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$",
          "maxLength": 40
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "source": {
          "enum": ["provider_reported", "catalog_estimate", "billing_reconciled"]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "service"],
      "properties": {
        "environment": { "$ref": "#/$defs/identifier" },
        "service": { "$ref": "#/$defs/identifier" },
        "release": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "attributeKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "not": {
        "pattern": "^(?:[Pp][Rr][Oo][Mm][Pp][Tt](?:[_.-]?(?:[Tt][Ee][Xx][Tt]|[Ll][Ee][Nn][Gg][Tt][Hh]))?|[Uu][Ss][Ee][Rr](?:[_.-]?[Ii][Dd])?|[Ee][Mm][Aa][Ii][Ll]|[Ii][Pp]|(?:[Ii][Mm][Aa][Gg][Ee]|[Mm][Ee][Dd][Ii][Aa]|[Rr][Ee][Ff][Ee][Rr][Ee][Nn][Cc][Ee][Ii][Mm][Aa][Gg][Ee])[_.-]?[Uu][Rr][Ll][Ss]?|[Aa][Pp][Ii][_.-]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]|[Ee][Rr][Rr][Oo][Rr](?:[_.-]?[Mm][Ee][Ss][Ss][Aa][Gg][Ee])?|[Rr][Aa][Ww][_.-]?[Ee][Rr][Rr][Oo][Rr]|[Ss][Tt][Aa][Cc][Kk]|[Ee][Xx][Tt][Ee][Rr][Nn][Aa][Ll][_.-]?[Rr][Ee][Qq][Uu][Ee][Ss][Tt][_.-]?[Ii][Dd])$"
      }
    },
    "safeAttributeString": {
      "type": "string",
      "maxLength": 240,
      "not": {
        "anyOf": [
          { "pattern": "[A-Za-z][A-Za-z0-9+.-]*://" },
          { "pattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+" },
          { "pattern": "(?:[Bb][Ee][Aa][Rr][Ee][Rr]|[Bb][Aa][Ss][Ii][Cc])\\s+" },
          { "pattern": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}" }
        ]
      }
    },
    "attributes": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": { "$ref": "#/$defs/attributeKey" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/safeAttributeString" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    },
    "operationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totalDurationMs": { "type": "number", "minimum": 0 },
        "attemptCount": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "attemptMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": { "type": "number", "minimum": 0 },
        "queueDurationMs": { "type": "number", "minimum": 0 },
        "outputUnits": { "type": "number", "minimum": 0 }
      }
    },
    "probeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": { "type": "number", "minimum": 0 }
      }
    },
    "operationAcceptedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "resource"],
      "properties": {
        "operation": { "$ref": "#/$defs/operation" },
        "resource": { "$ref": "#/$defs/resource" },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    },
    "operationTerminalData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "outcome", "resource"],
      "properties": {
        "operation": { "$ref": "#/$defs/operation" },
        "outcome": { "$ref": "#/$defs/terminalOutcome" },
        "metrics": { "$ref": "#/$defs/operationMetrics" },
        "resource": { "$ref": "#/$defs/resource" },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    },
    "attemptStartedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "attempt", "route", "resource"],
      "properties": {
        "operation": { "$ref": "#/$defs/operation" },
        "attempt": { "$ref": "#/$defs/attempt" },
        "route": { "$ref": "#/$defs/route" },
        "resource": { "$ref": "#/$defs/resource" },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    },
    "attemptTerminalData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "attempt", "route", "outcome", "resource"],
      "properties": {
        "operation": { "$ref": "#/$defs/operation" },
        "attempt": { "$ref": "#/$defs/attempt" },
        "route": { "$ref": "#/$defs/route" },
        "outcome": { "$ref": "#/$defs/terminalOutcome" },
        "metrics": { "$ref": "#/$defs/attemptMetrics" },
        "cost": { "$ref": "#/$defs/cost" },
        "resource": { "$ref": "#/$defs/resource" },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    },
    "providerProbeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "outcome", "resource"],
      "properties": {
        "route": { "$ref": "#/$defs/probeRoute" },
        "outcome": { "$ref": "#/$defs/probeOutcome" },
        "metrics": { "$ref": "#/$defs/probeMetrics" },
        "resource": { "$ref": "#/$defs/resource" },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    }
  }
}
