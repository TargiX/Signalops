{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalops.cc/schemas/ai-telemetry/v1/ingest-response.schema.json",
  "title": "SignalOps canonical telemetry v1 ingest success response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "requestId", "receipt"],
  "properties": {
    "ok": { "const": true },
    "requestId": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "receipt": { "$ref": "#/$defs/receipt" }
  },
  "$defs": {
    "eventIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "eventIdentifierList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/eventIdentifier" }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instancePath", "keyword", "message"],
      "properties": {
        "instancePath": { "type": "string", "maxLength": 512 },
        "keyword": { "type": "string", "minLength": 1, "maxLength": 80 },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "issues"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 99 },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/issue" }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedEvents",
        "rejectedEvents",
        "storedEvents",
        "duplicateEvents",
        "conflictEvents",
        "storedEventIds",
        "duplicateEventIds",
        "conflictEventIds",
        "rejected"
      ],
      "properties": {
        "acceptedEvents": { "type": "integer", "minimum": 0, "maximum": 100 },
        "rejectedEvents": { "type": "integer", "minimum": 0, "maximum": 100 },
        "storedEvents": { "type": "integer", "minimum": 0, "maximum": 100 },
        "duplicateEvents": { "type": "integer", "minimum": 0, "maximum": 100 },
        "conflictEvents": { "type": "integer", "minimum": 0, "maximum": 100 },
        "storedEventIds": { "$ref": "#/$defs/eventIdentifierList" },
        "duplicateEventIds": { "$ref": "#/$defs/eventIdentifierList" },
        "conflictEventIds": { "$ref": "#/$defs/eventIdentifierList" },
        "rejected": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/rejection" }
        }
      }
    }
  }
}
