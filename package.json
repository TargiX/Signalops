{
  "name": "signalops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3020",
    "dev:any": "next dev",
    "build": "next build",
    "start": "next start -p 3020",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "build:sdk": "pnpm --filter @signalops/node build",
    "prepare:cloudflare-d1-sql": "node scripts/prepare-cloudflare-d1-sql.mjs",
    "apply:cloudflare-d1-schema": "node scripts/apply-cloudflare-d1-schema.mjs",
    "prepare:supabase-sql": "node scripts/prepare-supabase-sql.mjs",
    "discover:cloudflare-d1": "node scripts/discover-cloudflare-d1.mjs",
    "test:signalops-alerts": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-signalops-alerts.mjs",
    "test:cloudflare-d1-discovery": "node scripts/test-cloudflare-d1-discovery.mjs",
    "test:cloudflare-d1-schema-apply": "node scripts/test-cloudflare-d1-schema-apply.mjs",
    "test:cockpit-session-guard": "node scripts/test-cockpit-session-guard.mjs",
    "test:cutover-verifier": "node scripts/test-cutover-verifier.mjs",
    "test:http-guards": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-http-guards.mjs",
    "test:ingest-auth": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-ingest-auth.mjs",
    "test:operator-access": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-operator-access.mjs",
    "test:operator-page-guards": "node scripts/test-operator-page-guards.mjs",
    "test:pilot-preflight": "node scripts/test-pilot-preflight.mjs",
    "test:pilot-intake-readiness": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-pilot-intake-readiness.mjs",
    "test:pilot-webhook-delivery": "node scripts/test-pilot-webhook-delivery.mjs",
    "test:rate-limits": "node scripts/test-rate-limits.mjs",
    "test:release-readiness": "node scripts/test-release-readiness.mjs",
    "test:runtime-config": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-runtime-config.mjs",
    "test:security-headers": "node scripts/test-security-headers.mjs",
    "test:signalops-cli": "pnpm build:sdk && node scripts/test-signalops-cli.mjs",
    "test:signalops-events": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-signalops-events.mjs",
    "test:signalops-pilot-workflow": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-signalops-pilot-workflow.mjs",
    "test:sdk": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-signalops-sdk.mjs",
    "verify:openapi": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-openapi.mjs",
    "verify:claims-honesty": "node scripts/verify-claims-honesty.mjs",
    "verify:env-template": "node scripts/verify-env-template.mjs",
    "verify:cutover": "node scripts/verify-cutover.mjs",
    "verify:release-readiness": "node scripts/verify-release-readiness.mjs",
    "verify:source-smoke": "node scripts/verify-source-smoke.mjs",
    "verify:pilot-preflight": "node scripts/verify-pilot-preflight.mjs",
    "verify:live-contracts": "node scripts/verify-live-contracts.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:signalops-events && pnpm test:signalops-alerts && pnpm test:signalops-pilot-workflow && pnpm test:cloudflare-d1-discovery && pnpm test:cloudflare-d1-schema-apply && pnpm test:cockpit-session-guard && pnpm test:cutover-verifier && pnpm test:http-guards && pnpm test:ingest-auth && pnpm test:operator-access && pnpm test:operator-page-guards && pnpm test:pilot-preflight && pnpm test:pilot-intake-readiness && pnpm test:pilot-webhook-delivery && pnpm test:rate-limits && pnpm test:release-readiness && pnpm test:runtime-config && pnpm test:security-headers && pnpm test:sdk && pnpm test:signalops-cli && pnpm verify:openapi && pnpm verify:claims-honesty && pnpm verify:env-template && pnpm build:sdk && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
