{
  "name": "@signalops/producer-node",
  "version": "0.1.0",
  "description": "Framework-neutral, privacy-safe Node.js producer adapter for SignalOps V1",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@signalops/contracts": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
