{
  "name": "@signalops/contracts",
  "version": "1.0.0",
  "description": "Framework-neutral TypeScript types for SignalOps Canonical AI Telemetry V1",
  "keywords": ["ai", "observability", "telemetry", "cloudevents", "llmops"],
  "homepage": "https://signalops.cc/docs",
  "bugs": { "url": "https://github.com/TargiX/signalops/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TargiX/signalops.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.js"
    },
    "./v1/event.schema.json": "./dist/artifacts/event.schema.json",
    "./v1/ingest-response.schema.json": "./dist/artifacts/ingest-response.schema.json",
    "./v1/semantic-validation": "./dist/artifacts/semantic-validation.mjs",
    "./v1/fixtures/*": "./dist/artifacts/fixtures/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-artifacts.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
